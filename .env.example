# Optional server-side provider configuration; this file is not automatically loaded.
OPENAI_API_KEY=
TRADEOPS_AI_MODEL=
# Optional isolated storage and alternate-port origin allowlist.
# IROP_DATA=/absolute/path/to/private/irop-data
# IROP_ORIGINS=http://127.0.0.1:8010,http://localhost:8010

# Optional official Flightradar24 API. Separate API subscription required.
FR24_API_TOKEN=
FR24_ENVIRONMENT=production

# Optional Auth0. When all three are set, mutating and private API routes require
# a validated access token. Desk isolation then comes from Organization / identity,
# not the X-IROP-Desk header. AUTH0_CLIENT_ID is the public SPA client id.
# AUTH0_DOMAIN=your-tenant.us.auth0.com
# AUTH0_AUDIENCE=https://flowbetter.local/api
# AUTH0_CLIENT_ID=
# Optional Organization id or name to require at login.
# AUTH0_ORGANIZATION=

# Container deployment behind Sites: exact hostname/origin, never wildcard
# IROP_ALLOWED_HOSTS=backend.example.com
# IROP_ORIGINS=https://backend.example.com
# IROP_PROXY_TOKEN=<server-only generated shared gateway secret>
# IROP_DATA=/data
# Sites server configuration (not the browser): SIMULATION_API_URL, SIMULATION_PROXY_TOKEN
